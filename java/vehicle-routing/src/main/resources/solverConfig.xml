<!-- global cap -->
<termination>
  <spentLimit>PT180S</spentLimit>
</termination>

<constructionHeuristic/>

<!-- Phase 1 explore a lot -->
<localSearch>
  <!-- let it wander longer before giving up -->
  <termination>
    <unimprovedSpentLimit>PT40S</unimprovedSpentLimit>
  </termination>

  <unionMoveSelector>
    <listChangeMoveSelector/>
    <listSwapMoveSelector/>
    <subListChangeMoveSelector/>
    <subListSwapMoveSelector/>
  </unionMoveSelector>

  <acceptor>
    <!-- big window = braver exploration -->
    <lateAcceptanceSize>1600</lateAcceptanceSize>
  </acceptor>
  <forager>
    <!-- consider a few accepted moves before picking -->
    <acceptedCountLimit>4</acceptedCountLimit>
  </forager>
</localSearch>

<!-- Phase 2 big jump to escape structures -->
<localSearch>
  <termination>
    <unimprovedSpentLimit>PT20S</unimprovedSpentLimit>
  </termination>

  <listRuinRecreateMoveSelector/>
  <acceptor>
    <lateAcceptanceSize>400</lateAcceptanceSize>
  </acceptor>
  <forager>
    <acceptedCountLimit>2</acceptedCountLimit>
  </forager>
</localSearch>

<!-- Phase 3 tighten to polish -->
<localSearch>
  <!-- run until global cap -->
  <unionMoveSelector>
    <listChangeMoveSelector/>
    <listSwapMoveSelector/>
    <subListChangeMoveSelector/>
    <subListSwapMoveSelector/>
  </unionMoveSelector>
  <acceptor>
    <entityTabuSize>9</entityTabuSize>
    <moveTabuSize>7</moveTabuSize>
  </acceptor>
  <forager>
    <acceptedCountLimit>1</acceptedCountLimit>
  </forager>
</localSearch>
